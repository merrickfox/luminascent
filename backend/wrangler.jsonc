/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "luminascent-backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-05",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "luminascent",
			"database_id": "4d524606-d2bf-48af-97eb-a956d3b1e72a",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "luminascent",
			"remote": true
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "USER_STORE",
				"class_name": "UserStore"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["UserStore"]
		}
	],
	"vars": {
		"ADMIN_API_KEY": "dev-admin-key",
		"R2_PUBLIC_BASE_URL": "https://pub-45a6fcb80891409e9b5b224fa471a158.r2.dev",
		// Supabase project URL. Used to fetch the JWKS (public signing keys) and
		// to pin the expected token issuer when verifying asymmetric (ES256/RS256)
		// access tokens.
		"SUPABASE_URL": "https://cmmwfokhmvcckgtjrekl.supabase.co",
		// Only used to verify legacy HS256 tokens (e.g. the test suite). Real
		// Supabase tokens are now asymmetric and verified via JWKS. Override
		// locally via backend/.dev.vars if you use legacy HS256 signing.
		"SUPABASE_JWT_SECRET": "dev-supabase-jwt-secret"
	}
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}